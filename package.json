{
  "private": true,
  "name": "@rcarls/workspace-root",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richardcarls/rc-webcomponents.git"
  },
  "homepage": "https://richardcarls.github.io/rc-webcomponents/",
  "description": "Themeable web components that enhance native HTML controls and implement APG patterns where they apply.",
  "author": "Richard Carls <richard.j.carls@gmail.com>",
  "license": "MIT",
  "packageManager": "yarn@4.16.0",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all --topological --exclude '@rcarls/rc-docs' run build",
    "test": "node scripts/playwright-env.mjs test:host",
    "test:host": "vitest --run",
    "test:full": "node scripts/playwright-env.mjs test:full:host",
    "test:full:host": "RC_FULL_BROWSER_MATRIX=1 RC_TEST_BROWSER=chromium vitest --run && RC_FULL_BROWSER_MATRIX=1 RC_TEST_BROWSER=firefox vitest --run && RC_FULL_BROWSER_MATRIX=1 RC_TEST_BROWSER=webkit vitest --run",
    "test:screenshots:update": "node scripts/playwright-env.mjs test:screenshots:update:host",
    "test:screenshots:update:host": "RC_TEST_BROWSER=chromium vitest --run rendered.test --update",
    "cem:analyze": "cem analyze",
    "docs": "yarn cem:analyze && yarn workspace @rcarls/rc-docs run dev",
    "docs:build": "yarn cem:analyze && yarn workspace @rcarls/rc-docs run build",
    "audit:component-architecture": "yarn cem:analyze && node scripts/audit-component-architecture.mjs",
    "audit:api-surfaces": "node scripts/audit-api-surfaces.mjs",
    "audit:performance": "node scripts/audit-performance.mjs",
    "audit:performance:update": "node scripts/audit-performance.mjs --update-baseline",
    "benchmark:browser": "node scripts/playwright-env.mjs benchmark:browser:host",
    "benchmark:browser:host": "node scripts/benchmark-browser.mjs",
    "benchmark:browser:update": "node scripts/playwright-env.mjs benchmark:browser:update:host",
    "benchmark:browser:update:host": "node scripts/benchmark-browser.mjs --update-baseline",
    "tokens:build": "node scripts/build-design-tokens.mjs",
    "codegen:aggregate": "node scripts/generate-aggregate-exports.mjs",
    "codegen:aggregate:check": "node scripts/generate-aggregate-exports.mjs --check",
    "validate:packages": "node scripts/validate-packages.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "test:release-validation": "node --test scripts/validate-release.test.mjs",
    "test:release-scripts": "node --test scripts/playwright-env.test.mjs scripts/validate-release.test.mjs scripts/publish-workspaces.test.mjs scripts/bootstrap-trusted-publisher.test.mjs scripts/build-design-tokens.test.mjs scripts/audit-performance.test.mjs scripts/benchmark-browser.test.mjs scripts/generate-aggregate-exports.test.mjs",
    "test:architecture-audit": "yarn cem:analyze && node --test scripts/audit-component-architecture.test.mjs",
    "test:design-tokens": "node --test scripts/build-design-tokens.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "node scripts/playwright-env.mjs ci:host",
    "ci:host": "yarn codegen:aggregate:check && yarn build && yarn validate:packages && yarn audit:component-architecture && yarn audit:performance && yarn benchmark:browser:host && yarn test:architecture-audit && yarn test:release-scripts && yarn test:full:host",
    "version:packages": "changeset version",
    "version:packages:snapshot": "changeset version --snapshot",
    "bootstrap:trusted-publisher": "node scripts/bootstrap-trusted-publisher.mjs",
    "publish:packages": "node scripts/publish-workspaces.mjs",
    "publish:packages:dry-run": "node scripts/publish-workspaces.mjs --dry-run",
    "publish:packages:snapshot": "node scripts/publish-workspaces.mjs --snapshot",
    "publish:packages:snapshot:dry-run": "node scripts/publish-workspaces.mjs --snapshot --dry-run",
    "release:check": "yarn validate:release && yarn ci && yarn publish:packages:dry-run",
    "prepare": "husky"
  },
  "customElements": "dist/custom-elements.json",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@types/node": "^25.6.0",
    "@vitest/browser-playwright": "4.1.5",
    "@yarnpkg/types": "^4.0.1",
    "api-viewer-element": "^1.0.0-pre.10",
    "axe-core": "^4.11.4",
    "husky": "^9.1.7",
    "lit": "^3.0.0",
    "playwright": "^1.56.0",
    "prettier": "^3.8.4",
    "rollup": "^4.60.2",
    "tar": "^7.5.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.6",
    "vitest-browser-lit": "^1.0.1"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "dependenciesMeta": {
    "vitest-browser-lit": {
      "unplugged": true
    }
  }
}
